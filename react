            <div className="chat-last">{room.messages && room.messages.length ? room.messages[room.messages.length-1].text : 'Sem mensagens'}</div>
          </div>
        </div>
      ))}
    </div>
  )
}

--- client/src/components/ChatWindow.jsx ---
import React, { useEffect, useState, useRef } from 'react'

export default function ChatWindow({ room, socket, user }){
  const [messages, setMessages] = useState([])
  const [text, setText] = useState('')
  const endRef = useRef()

  useEffect(()=>{
    // pegar histórico por REST
    fetch(`http://localhost:4000/rooms/${room.id}`).then(r=>r.json()).then(data=>setMessages(data.messages || []))

    const onReceive = (msg) => setMessages(prev=>[...prev, msg])
    const onSystem = (msg) => setMessages(prev=>[...prev, { id: Date.now()+Math.random(), user: 'Sistema', system: true, text: msg }])

    socket.on('receiveMessage', onReceive)
    socket.on('systemMessage', onSystem)

    return ()=>{
      socket.off('receiveMessage', onReceive)
      socket.off('systemMessage', onSystem)
    }
  }, [room])

  useEffect(()=> endRef.current?.scrollIntoView({ behavior: 'smooth' }), [messages])

  const send = () => {
    if(!text.trim()) return
    const msg = { user, text: text.trim(), at: new Date().toISOString() }
    socket.emit('sendMessage', room.id, msg)
    setText('')
  }

  return (
    <div className="chat-window">
      <header className="chat-header">{room.title}</header>
      <div className="messages">
        {messages.map(m => (
          <div key={m.id} className={`message ${m.user===user ? 'me' : ''} ${m.system ? 'system' : ''}`}>
            {!m.system && <div className="author">{m.user}</div>}
            <div className="bubble">{m.text}</div>
            <div className="time">{new Date(m.at || Date.now()).toLocaleTimeString()}</div>
          </div>
        ))}
        <div ref={endRef} />
      </div>
      <footer className="chat-input">
        <input value={text} onChange={e=>setText(e.target.value)} onKeyDown={e=> e.key==='Enter' && send()} placeholder="Digite uma mensagem..." />
        <button onClick={send}>Enviar</button>
      </footer>
    </div>
  )
}

