import React from 'react'

export default function ChatList({ rooms, onEnter }){
  return (
    <div className="chat-list">
      {rooms.map(room => (
        <div key={room.id} className="chat-item" onClick={()=>onEnter(room)}>
          <div className="chat-thumb">{room.title[0]}</div>
          <div className="chat-info">
