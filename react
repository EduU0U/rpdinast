--- server/index.js ---
const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const cors = require('cors');
const path = require('path');

const app = express();
app.use(cors());
app.use(express.json());

const server = http.createServer(app);
const io = new Server(server, {
  cors: { origin: '*' }
});

// Dados em memória (para demo). Troque por DB em produção.
const rooms = {
  general: { id: 'general', title: 'Geral', messages: [] },
  memes: { id: 'memes', title: 'Memes', messages: [] }
};

app.get('/rooms', (req, res) => {
  res.json(Object.values(rooms));
});

app.get('/rooms/:id', (req, res) => {
  const room = rooms[req.params.id];
  if (!room) return res.status(404).json({ error: 'Sala não encontrada' });
  res.json(room);
});

io.on('connection', (socket) => {
  console.log('Novo cliente conectado', socket.id);

  socket.on('joinRoom', (roomId, user) => {
    socket.join(roomId);
    socket.to(roomId).emit('systemMessage', `${user} entrou na sala`);
  });

  socket.on('leaveRoom', (roomId, user) => {
    socket.leave(roomId);
    socket.to(roomId).emit('systemMessage', `${user} saiu da sala`);
  });

  socket.on('sendMessage', (roomId, message) => {
    // salvar em memória
    const msg = { id: Date.now() + Math.random(), ...message };
    if (rooms[roomId]) rooms[roomId].messages.push(msg);
    io.to(roomId).emit('receiveMessage', msg);
  });

  socket.on('disconnect', () => {
    console.log('Cliente desconectado', socket.id);
  });
});

const PORT = process.env.PORT || 4000;
server.listen(PORT, () => console.log(`Servidor rodando na porta ${PORT}`));

