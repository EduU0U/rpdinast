--- client/src/App.jsx ---
import React, { useEffect, useState } from 'react'
import io from 'socket.io-client'
import ChatList from './components/ChatList'
import ChatWindow from './components/ChatWindow'

const SERVER = import.meta.env.VITE_SERVER_URL || 'http://localhost:4000'
const socket = io(SERVER)

export default function App(){
  const [rooms, setRooms] = useState([])
  const [currentRoom, setCurrentRoom] = useState(null)
  const [user, setUser] = useState(() => localStorage.getItem('user') || '')

  useEffect(()=>{
    fetch(`${SERVER}/rooms`).then(r=>r.json()).then(data=>setRooms(data))
  },[])

  useEffect(()=>{
    return ()=> socket.disconnect()
  },[])

  const enterRoom = (room) => {
    if(!user) return alert('Escolha um nick antes de entrar.')
    setCurrentRoom(room)
    socket.emit('joinRoom', room.id, user)
  }

  return (
    <div className="app">
      <aside className="sidebar">
        <div className="profile">
          <input placeholder="Seu nick" value={user} onChange={e=>{setUser(e.target.value); localStorage.setItem('user', e.target.value)}} />
        </div>
        <ChatList rooms={rooms} onEnter={enterRoom} />
      </aside>
      <main className="main">
        {currentRoom ? (
          <ChatWindow room={currentRoom} socket={socket} user={user} />
        ) : (
          <div className="empty">Escolha uma sala para começar a conversar</div>
        )}
      </main>
    </div>
  )
}

